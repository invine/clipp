{
  "schema": 1,
  "preflight": { "minimumFreeBytes": 3221225472 },
  "commonChecks": [
    { "id": "lint", "command": ["npm", "run", "lint"] },
    { "id": "typecheck", "command": ["npm", "run", "typecheck"] },
    { "id": "jest", "command": ["npm", "test", "--", "--runInBand"] },
    { "id": "candidate-tooling", "command": ["npm", "run", "check:candidate"] },
    { "id": "delivery-tooling", "command": ["npm", "run", "check:delivery"] },
    {
      "id": "electron-build",
      "command": ["npm", "--workspace", "apps/electron", "run", "build"]
    },
    {
      "id": "android-web-build",
      "command": ["npm", "--workspace", "apps/android", "run", "build"]
    },
    {
      "id": "chrome-build",
      "command": ["npm", "--workspace", "apps/extension", "run", "build"]
    },
    { "id": "ui-behavior", "command": ["npm", "run", "test:ui-behavior"] }
  ],
  "targets": {
    "electron-package": {
      "dependsOn": [],
      "checks": [
        "common-verify",
        "ui-behavior",
        "electron-inventory",
        "electron-native-webrtc",
        "electron-quit"
      ],
      "signing": "unsigned-local",
      "destination": "artifact"
    },
    "electron-local": {
      "dependsOn": ["electron-package"],
      "checks": [
        "electron-installed-identity",
        "electron-installed-launch-quit"
      ],
      "signing": "unsigned-local",
      "destination": "electronInstallPath"
    },
    "chrome-local": {
      "dependsOn": [],
      "checks": [
        "common-verify",
        "ui-behavior",
        "chrome-production-inventory",
        "chrome-populated-history",
        "chrome-loaded-identity",
        "chrome-popup"
      ],
      "signing": "unpacked",
      "destination": "chromeExtensionDir"
    },
    "android-package": {
      "dependsOn": ["android-qualification"],
      "checks": [
        "common-verify",
        "android-native-unit",
        "android-native-matrix",
        "android-package-inventory",
        "android-signature"
      ],
      "signing": "upload",
      "destination": "artifact"
    },
    "android-local": {
      "dependsOn": ["android-qualification", "android-package"],
      "checks": [
        "android-device-compatibility",
        "android-installed-identity",
        "android-readiness"
      ],
      "signing": "debug-or-upload",
      "destination": "androidDeviceSerial"
    },
    "android-internal": {
      "dependsOn": ["android-qualification", "android-package"],
      "checks": ["android-play-upload", "android-play-release-readback"],
      "signing": "upload",
      "destination": "playApplicationId"
    }
  },
  "supportedHost": { "platform": "darwin", "architectures": ["arm64"] },
  "toolchain": {
    "node": ">=22.22.1",
    "npm": ">=10.0.0",
    "electronBuilder": "26.18.0",
    "gradle": "wrapper"
  }
}
