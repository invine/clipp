{
  "name": "clipp-android",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "cap:copy": "cap copy",
    "cap:sync": "cap sync",
    "cap:open:android": "cap open android",
    "test:native:unit": "cd android && ./gradlew :app:testDebugUnitTest",
    "test:native:instrumentation": "node scripts/android-readiness.mjs --serial \"$CLIPP_TEST_SERIAL\" --candidate-apk \"$CLIPP_ANDROID_CANDIDATE_APK\" --output \"$CLIPP_ANDROID_EVIDENCE_DIR\" --suite matrix",
    "test:native:instrumentation:api31": "node scripts/android-readiness.mjs --serial \"$CLIPP_TEST_SERIAL\" --candidate-apk \"$CLIPP_ANDROID_CANDIDATE_APK\" --output \"$CLIPP_ANDROID_EVIDENCE_DIR\" --suite matrix --expected-api 31",
    "test:native:instrumentation:api33": "node scripts/android-readiness.mjs --serial \"$CLIPP_TEST_SERIAL\" --candidate-apk \"$CLIPP_ANDROID_CANDIDATE_APK\" --output \"$CLIPP_ANDROID_EVIDENCE_DIR\" --suite matrix --expected-api 33",
    "test:native:instrumentation:api34": "node scripts/android-readiness.mjs --serial \"$CLIPP_TEST_SERIAL\" --candidate-apk \"$CLIPP_ANDROID_CANDIDATE_APK\" --output \"$CLIPP_ANDROID_EVIDENCE_DIR\" --suite matrix --expected-api 34",
    "test:native:instrumentation:api35": "node scripts/android-readiness.mjs --serial \"$CLIPP_TEST_SERIAL\" --candidate-apk \"$CLIPP_ANDROID_CANDIDATE_APK\" --output \"$CLIPP_ANDROID_EVIDENCE_DIR\" --suite matrix --expected-api 35",
    "test:native:instrumentation:api36": "node scripts/android-readiness.mjs --serial \"$CLIPP_TEST_SERIAL\" --candidate-apk \"$CLIPP_ANDROID_CANDIDATE_APK\" --output \"$CLIPP_ANDROID_EVIDENCE_DIR\" --suite matrix --expected-api 36",
    "build:native:acceptance-candidate": "node scripts/build-acceptance-candidate.mjs",
    "test:native:readiness": "node scripts/android-readiness.mjs --serial \"$CLIPP_TEST_SERIAL\" --candidate-apk \"$CLIPP_ANDROID_CANDIDATE_APK\" --output \"$CLIPP_ANDROID_EVIDENCE_DIR\" --suite readiness",
    "test:native:instrumentation:matrix": "node scripts/android-readiness.mjs --serial \"$CLIPP_TEST_SERIAL\" --candidate-apk \"$CLIPP_ANDROID_CANDIDATE_APK\" --output \"$CLIPP_ANDROID_EVIDENCE_DIR\" --suite matrix",
    "test:native:instrumentation:connected": "node scripts/android-readiness.mjs --serial \"$CLIPP_TEST_SERIAL\" --candidate-apk \"$CLIPP_ANDROID_CANDIDATE_APK\" --output \"$CLIPP_ANDROID_EVIDENCE_DIR\" --suite matrix",
    "build:native:release": "cd android && ./gradlew :app:assembleRelease",
    "test:native:instrumentation:focused": "node scripts/android-readiness.mjs --serial \"$CLIPP_TEST_SERIAL\" --candidate-apk \"$CLIPP_ANDROID_CANDIDATE_APK\" --output \"$CLIPP_ANDROID_EVIDENCE_DIR\" --suite focused"
  },
  "dependencies": {
    "@capacitor/clipboard": "^7.0.2",
    "@capacitor/core": "^7.0.2",
    "@capacitor/local-notifications": "^7.0.7",
    "@capacitor/preferences": "^7.0.2",
    "jsqr": "^1.4.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@capacitor/android": "^7.0.2",
    "@capacitor/cli": "^7.0.2",
    "@capacitor/ios": "^7.0.2",
    "@vitejs/plugin-react": "^4.4.1",
