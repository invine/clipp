{
  "name": "clipp-electron",
  "version": "0.0.0",
  "private": true,
  "type": "commonjs",
  "main": "dist/main.cjs",
  "scripts": {
    "dev:renderer": "vite --config vite.config.ts",
    "dev:electron": "npm run build:main && VITE_DEV_SERVER_URL=http://localhost:4173 electron .",
    "build": "npm run build:main && npm run build:renderer",
    "build:main": "node esbuild.preload.mjs && node esbuild.main.mjs",
    "build:renderer": "vite build",
    "build:reset-owning-acceptance": "node scripts/build-reset-owning-acceptance.mjs --build-reset-owning-entry",
    "build:pairing-owning-acceptance": "node scripts/build-pairing-owning-acceptance.mjs --build-pairing-owning-entry",
    "typecheck:main": "tsc -p tsconfig.main.json --noEmit"
  },
  "dependencies": {
    "@koush/wrtc": "^0.5.3",
    "better-sqlite3": "13.0.3",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.4.1",
    "electron": "43.4.0",
    "esbuild": "^0.25.4",
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  },
  "build": {
    "appId": "com.clipp.app",
    "productName": "Clipp",
    "directories": {
      "buildResources": "assets/icons",
      "output": "release"
    },
    "mac": {
      "icon": "assets/icons/clipp-appicon.icns",
      "target": [
        "dmg"
      ]
    },
    "extraResources": [
      {
        "from": "assets/icons",
        "to": "clipp-electron-icons-bundle",
        "filter": [
          "clipp-appicon-256.png",
          "clipp-trayTemplate-16.png",
          "clipp-trayTemplate-32.png",
          "clipp-trayTemplate-64.png"
        ]
      }
    ]
  }
}
