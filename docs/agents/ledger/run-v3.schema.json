{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schemaVersion",
    "runId",
    "coordinator",
    "maxImplementers",
    "tracker",
    "repositories",
    "tickets",
    "claims",
    "integrations",
    "evidence",
    "ownership",
    "scenarios"
  ],
  "additionalProperties": false,
  "$id": "https://clipp.local/agent-workflow/run-v3.schema.json",
  "title": "Clipp agent workflow run v3: finite scenario allocation",
  "properties": {
    "runId": {
      "$ref": "run-v2.schema.json#/properties/runId"
    },
    "coordinator": {
      "$ref": "run-v2.schema.json#/properties/coordinator"
    },
    "maxImplementers": {
      "$ref": "run-v2.schema.json#/properties/maxImplementers"
    },
    "tracker": {
      "$ref": "run-v2.schema.json#/properties/tracker"
    },
    "repositories": {
      "$ref": "run-v2.schema.json#/properties/repositories"
    },
    "tickets": {
      "$ref": "run-v2.schema.json#/properties/tickets"
    },
    "claims": {
      "$ref": "run-v2.schema.json#/properties/claims"
    },
    "integrations": {
      "$ref": "run-v2.schema.json#/properties/integrations"
    },
    "evidence": {
      "$ref": "run-v2.schema.json#/properties/evidence"
    },
    "ownership": {
      "$ref": "run-v2.schema.json#/properties/ownership"
    },
    "operational": {
      "$ref": "run-v2.schema.json#/properties/operational"
    },
    "schemaVersion": {
      "const": 3
    },
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "maxItems": 500,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": [
          "id",
          "consumingOutput",
          "runtime",
          "expectedObservation",
          "evidenceType",
          "primaryOwner",
          "requirement",
          "prerequisites",
          "contributors",
          "disposition"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "consumingOutput": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "runtime": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "expectedObservation": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "evidenceType": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "primaryOwner": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "requirement": {
            "$ref": "run-v2.schema.json#/properties/ownership/properties/specification"
          },
          "prerequisites": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            },
            "minItems": 0,
            "maxItems": 500,
            "uniqueItems": true
          },
          "contributors": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            },
            "minItems": 0,
            "maxItems": 500,
            "uniqueItems": true
          },
          "disposition": {
            "enum": ["Candidate", "External", "Retained"]
          }
        },
        "additionalProperties": false
      }
    },
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "revisions": {
            "$ref": "run-v1.schema.json#/properties/evidence/items/properties/revisions"
          },
          "inputs": {
            "type": "object",
            "properties": {
              "toolchain": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$",
                "minLength": 64,
                "maxLength": 64
              },
              "dependencies": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$",
                "minLength": 64,
                "maxLength": 64
              },
              "build": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$",
                "minLength": 64,
                "maxLength": 64
              },
              "runner": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$",
                "minLength": 64,
                "maxLength": 64
              },
              "fault": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$",
                "minLength": 64,
                "maxLength": 64
              },
              "artifact": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$",
                "minLength": 64,
                "maxLength": 64
              },
              "environment": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$",
                "minLength": 64,
                "maxLength": 64
              }
            },
            "required": [
              "toolchain",
              "dependencies",
              "build",
              "runner",
              "fault",
              "artifact",
              "environment"
            ],
            "additionalProperties": false
          }
        },
        "required": ["id", "revisions", "inputs"],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 500,
      "uniqueItems": true
    },
    "evidenceBindings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "evidenceId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "candidateId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "scenarioIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            },
            "minItems": 1,
            "maxItems": 500,
            "uniqueItems": true
          },
          "scenarioDigest": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$",
            "minLength": 64,
            "maxLength": 64
          },
          "relevantInputs": {
            "type": "array",
            "items": {
              "$ref": "run-v2.schema.json#/properties/ownership/properties/specification"
            },
            "minItems": 1,
            "maxItems": 500,
            "uniqueItems": true
          }
        },
        "required": [
          "evidenceId",
          "candidateId",
          "scenarioIds",
          "scenarioDigest",
          "relevantInputs"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 500,
      "uniqueItems": true
    },
    "carryForwards": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "evidenceId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "scenarioId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "candidateId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "relevantInputs": {
            "type": "array",
            "items": {
              "$ref": "run-v2.schema.json#/properties/ownership/properties/specification"
            },
            "minItems": 1,
            "maxItems": 500,
            "uniqueItems": true
          },
          "assessedChanges": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "role": {
                  "enum": ["client", "relay"]
                },
                "path": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4096
                },
                "assessment": {
                  "enum": [
                    "status-only",
                    "documentation-only",
                    "unrelated",
                    "changed",
                    "unknown"
                  ]
                },
                "rationale": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4096
                },
                "before": {
                  "type": "string",
                  "minLength": 6,
                  "maxLength": 40,
                  "pattern": "^(absent|[a-f0-9]{40})$"
                },
                "after": {
                  "type": "string",
                  "minLength": 6,
                  "maxLength": 40,
                  "pattern": "^(absent|[a-f0-9]{40})$"
                }
              },
              "required": [
                "role",
                "path",
                "assessment",
                "rationale",
                "before",
                "after"
              ],
              "additionalProperties": false
            },
            "minItems": 0,
            "maxItems": 500,
            "uniqueItems": true
          },
          "rationale": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "reviewer": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          }
        },
        "required": [
          "evidenceId",
          "scenarioId",
          "candidateId",
          "relevantInputs",
          "assessedChanges",
          "rationale",
          "reviewer"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 500,
      "uniqueItems": true
    }
  }
}
