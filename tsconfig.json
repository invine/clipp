{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Node",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "paths": {
      "@core/*": ["./packages/core/*"]
    },
    "types": ["jest", "node"]
  },
  "include": ["packages/**/*", "tests/**/*", "global.d.ts"]
}
